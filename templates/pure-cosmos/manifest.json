{
  "schemaVersion": 1,
  "id": "pure-cosmos",
  "name": "Pure Cosmos",
  "description": "A spiral galaxy and a giant ringed horizon over a mirror sea, with orbiting stars, shooting stars, a pulsing sunrise and drifting cosmic dust.",
  "author": "seeWallpaper",
  "version": "1.0.0",
  "category": "Space",
  "engine": "web",
  "entry": "index.html",
  "preview": "preview.jpg",
