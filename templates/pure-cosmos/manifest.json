    },
    {
      "id": "intensity",
      "type": "slider",
      "label": "Glow intensity",
      "min": 0.3,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "id": "starDensity",
      "type": "slider",
      "label": "Star density",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "default": 1
    }
  ]
}
