{
  "schemaVersion": 1,
  "id": "rain-on-glass",
  "name": "Rain on Glass",
  "description": "Photographic blue-hour rain on a pane of glass: droplets settle, grow, merge and slide under gravity, leaving fading wet trails. Real-time refraction, curved reflections and tiny beads over an original city photograph. Entirely offline.",
  "author": "seeWallpaper",
  "version": "1.0.0",
  "category": "Nature",
  "engine": "web",
  "entry": "index.html",
  "preview": "preview.jpg",
  "performance": "medium",
  "settings": [
    { "id": "rain", "type": "slider", "label": "Rain intensity", "min": 0, "max": 2, "step": 0.1, "default": 1 },
    { "id": "speed", "type": "slider", "label": "Droplet speed", "min": 0.2, "max": 2, "step": 0.1, "default": 1 },
    { "id": "refraction", "type": "slider", "label": "Water refraction", "min": 0.3, "max": 2, "step": 0.1, "default": 1 },
    { "id": "blur", "type": "slider", "label": "Background softness", "min": 0, "max": 10, "step": 1, "default": 4 },
    { "id": "color", "type": "color", "label": "Glass reflection tint", "default": "#c9d5df" },
    { "id": "trails", "type": "boolean", "label": "Wet trails", "default": true }
  ]
}
