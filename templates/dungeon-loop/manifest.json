{
  "schemaVersion": 1,
  "id": "dungeon-loop",
  "name": "Dungeon Loop",
  "description": "An original adventurer automatically explores connected dungeon corridors, fights stone sentries, opens treasure chests and descends to the next floor. Procedural artwork, entirely offline.",
  "author": "seeWallpaper",
  "version": "1.0.0",
  "category": "Games",
  "engine": "web",
  "entry": "index.html",
  "preview": "preview.jpg",
  "performance": "low",
  "settings": [
    {
      "id": "color",
      "type": "color",
      "label": "Scene accent",
      "default": "#bba4e7"
    },
    {
      "id": "speed",
      "type": "slider",
      "label": "Simulation speed",
      "min": 0.3,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "id": "particles",
      "type": "boolean",
      "label": "Action particles",
      "default": true
    },
    {
      "id": "stats",
      "type": "boolean",
      "label": "Show simulation progress",
      "default": true
    }
  ]
}
