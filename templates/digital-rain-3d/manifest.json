{
  "schemaVersion": 1,
  "id": "digital-rain-3d",
  "name": "Digital Rain 3D",
  "description": "Matrix code rain in three depth planes with focus blur, mirrored glyphs that mutate as they fall, a clock revealed by the rain, CRT scanlines and occasional glitches.",
  "author": "seeWallpaper",
  "version": "2.0.0",
  "category": "Matrix",
  "engine": "web",
  "entry": "index.html",
  "preview": "preview.jpg",
  "performance": "medium",
  "settings": [
    {
      "id": "color",
      "type": "color",
      "label": "Main color",
      "default": "#00ff66"
    },
    {
      "id": "speed",
      "type": "slider",
      "label": "Animation speed",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "id": "density",
      "type": "slider",
      "label": "Rain density",
      "min": 0.3,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "id": "glow",
      "type": "boolean",
      "label": "Glow",
      "default": true
    },
    {
      "id": "clock",
      "type": "boolean",
      "label": "Show the time in the rain",
      "default": true
    },
    {
      "id": "glitch",
      "type": "boolean",
      "label": "Glitch effects",
      "default": true
    }
  ]
}
