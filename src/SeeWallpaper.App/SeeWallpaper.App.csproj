<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\seewallpaper.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <Authors>Michael Ruffenach</Authors>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the notification area icon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SeeWallpaper.App.Tests" />
    <ProjectReference Include="..\SeeWallpaper.Core\SeeWallpaper.Core.csproj" />
    <ProjectReference Include="..\SeeWallpaper.TemplateEngine\SeeWallpaper.TemplateEngine.csproj" />
    <ProjectReference Include="..\SeeWallpaper.Infrastructure\SeeWallpaper.Infrastructure.csproj" />
    <ProjectReference Include="..\SeeWallpaper.Engine\SeeWallpaper.Engine.csproj" />
    <ProjectReference Include="..\SeeWallpaper.System\SeeWallpaper.System.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\seewallpaper.png" Link="Assets\seewallpaper.png" />
    <Content Include="..\..\templates\**\*" Link="templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
