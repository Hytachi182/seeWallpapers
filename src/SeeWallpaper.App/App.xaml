<Application x:Class="SeeWallpaper.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <BitmapImage x:Key="BrandIcon" UriSource="/SeeWallpaper.App;component/Assets/seewallpaper.png"/>
    <Style TargetType="Window"><Setter Property="Icon" Value="{StaticResource BrandIcon}"/></Style>
    <SolidColorBrush x:Key="Canvas" Color="#10121A"/>
    <SolidColorBrush x:Key="Panel" Color="#181B26"/>
    <SolidColorBrush x:Key="Muted" Color="#AEB7C9"/>
    <SolidColorBrush x:Key="Accent" Color="#8B7CFF"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#292E40"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
