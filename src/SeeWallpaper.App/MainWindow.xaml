<Window x:Class="SeeWallpaper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SeeWallpaper.App" Title="seeWallpaper" Icon="{StaticResource BrandIcon}" Width="1240" Height="790" MinWidth="980" MinHeight="640" Background="{StaticResource Canvas}" Foreground="White" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#141620" Padding="18,24">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,30"><Image Source="{StaticResource BrandIcon}" Width="28" Height="28"/><TextBlock Text="seeWallpaper" FontSize="22" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <Button Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="{local:Translate Key=Home}" Click="Home_Click"/><Button Style="{StaticResource NavButton}" Tag="&#xE8B9;" Content="{local:Translate Key=Gallery}" Click="Gallery_Click"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE774;" x:Name="OnlineButton" Content="{local:Translate Key=Online}" Click="Online_Click" ToolTip="{local:Translate Key=NewWallpapersPublishedOnGitHub}"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="{local:Translate Key=Displays}" Click="Screens_Click"/><Button Style="{StaticResource NavButton}" Tag="&#xE8EE;" Content="{local:Translate Key=Rotation}" Click="Rotation_Click" ToolTip="{local:Translate Key=ChangeWallpapersAutomatically}"/><Button Style="{StaticResource NavButton}" Tag="&#xE896;" Content="{local:Translate Key=Installed}" Click="Installed_Click"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE734;" Content="{local:Translate Key=Favorites}" Click="Favorites_Click"/><Button Style="{StaticResource NavButton}" Tag="&#xE710;" Content="{local:Translate Key=Create}" Click="Create_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Style="{StaticResource NavButton}" Tag="&#xE774;" x:Name="LanguageButton" Click="Language_Click" ToolTip="{local:Translate Key=ChangeTheApplicationLanguage}" AutomationProperties.Name="{local:Translate Key=ChangeTheApplicationLanguage}"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE895;" x:Name="CheckUpdateButton" Content="{local:Translate Key=CheckUpdate}" Click="CheckUpdate_Click" ToolTip="{local:Translate Key=CompareYourVersionWithGitHubMain}"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE946;" x:Name="AboutButton" Content="{local:Translate Key=About}" Click="About_Click"/>
          <Button Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{local:Translate Key=Settings}" Click="Settings_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#2A2238" BorderBrush="#F5B84B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="UpdateTitle" Text="{local:Translate Key=ApplicationUpdates}" FontWeight="SemiBold" Foreground="#F5B84B" TextWrapping="Wrap"/>
              <TextBlock x:Name="UpdateDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="5" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0" AutomationProperties.Name="{local:Translate Key=DownloadingApplicationUpdate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button x:Name="DownloadUpdateButton" Content="{local:Translate Key=InstallApplicationUpdate}" Click="DownloadUpdate_Click" Background="{StaticResource Accent}" Margin="0" Visibility="Collapsed"/>
              <Button x:Name="CancelUpdateButton" Content="{local:Translate Key=Cancel}" Click="CancelUpdate_Click" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="StartupBanner" Visibility="Collapsed" Background="#2A2238" BorderBrush="#F5B84B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{local:Translate Key=SeeWallpaperDoesNotStartWithWindows}" FontWeight="SemiBold" Foreground="#F5B84B"/>
              <TextBlock Text="{local:Translate Key=AfterARestartYourWallpapersStayOffUntilYouOpenTheAppWithStartupEnabledTheyComeBa}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{local:Translate Key=StartWithWindows}" Click="EnableStartup_Click" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{local:Translate Key=NotNow}" Click="DismissStartup_Click" VerticalAlignment="Center" Margin="0"/>
          </Grid>
        </Border>
        <TextBlock x:Name="PageTitle" Text="{local:Translate Key=ChooseYourWallpaper}" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageDescription" Text="{local:Translate Key=ChooseASceneThenSelectTheDisplaysWhereItShouldRun}" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="PageActions" Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="{local:Translate Key=ManageMyDisplays}" Click="Screens_Click" Margin="0,0,10,0"/>
          <Button Content="{local:Translate Key=ImportSeewall}" Click="Import_Click" Margin="0"/>
        </StackPanel>
      </StackPanel>
      <Grid x:Name="GalleryView" Grid.Row="1" Margin="0,24,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
          <Label Target="{Binding ElementName=GallerySearch}" Content="{local:Translate Key=SearchWallpapers}" Foreground="{StaticResource Muted}" Padding="0,0,0,6"/>
          <Grid MaxWidth="600" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GallerySearch" TextChanged="GallerySearch_TextChanged" MinHeight="40" Padding="12,8" FontSize="15" VerticalContentAlignment="Center" Background="{StaticResource Panel}" Foreground="White" CaretBrush="White" BorderBrush="{StaticResource Muted}" BorderThickness="1" AutomationProperties.Name="{local:Translate Key=SearchWallpapers}"/>
            <Button x:Name="ClearGallerySearch" Grid.Column="1" Content="{local:Translate Key=ClearSearch}" Click="ClearGallerySearch_Click" IsEnabled="False" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock x:Name="GallerySearchEmpty" Text="{local:Translate Key=NoMatchingWallpapers}" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="TemplateList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:TemplateCardViewModel}">
              <Border Width="290" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,16,20">
                <StackPanel>
                  <Border Height="155" Background="{Binding Visual}" CornerRadius="14,14,0,0" ClipToBounds="True">
                    <Grid><Image Source="{Binding Preview}" Stretch="UniformToFill"/><Border Background="#CC10121A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" Margin="12"><TextBlock Text="{Binding Category}"/></Border></Grid>
                  </Border>
                  <StackPanel Margin="16">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Content="{local:Translate Key=ApplyToMyDisplays}" Tag="{Binding}" Click="Apply_Click" Background="{StaticResource Accent}"/>
                    <StackPanel Orientation="Horizontal"><Button Content="{local:Translate Key=Preview}" Tag="{Binding}" Click="Preview_Click" Margin="0,0,8,0"/><Button Content="{local:Translate Key=Customize}" Tag="{Binding}" Click="Customize_Click" Margin="0"/></StackPanel>
                    <Expander Header="{local:Translate Key=MoreActions}" Foreground="{StaticResource Muted}" Margin="0,12,0,0">
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="{local:Translate Key=Favorite}" Tag="{Binding}" Click="Favorite_Click" Margin="0,0,6,6"/>
                        <Button Content="{local:Translate Key=Export}" Tag="{Binding}" Click="Export_Click" Margin="0,0,6,6"/>
                        <Button Content="{local:Translate Key=Duplicate}" Tag="{Binding}" Click="Duplicate_Click" Margin="0,0,6,6"/>
                        <Button Content="{local:Translate Key=Uninstall}" Tag="{Binding}" Click="Uninstall_Click" Margin="0,0,6,6"/>
                      </WrapPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </Grid>
      <ScrollViewer x:Name="OnlineView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="OnlineRefreshButton" Content="{local:Translate Key=CheckAgain}" Click="OnlineRefresh_Click" Margin="0,0,12,0"/>
            <TextBlock x:Name="OnlineNotice" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
          </StackPanel>
          <ItemsControl x:Name="OnlineList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:OnlineTemplateCardViewModel}">
                <Border Width="290" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,16,20">
                  <StackPanel>
                    <Border Height="155" Background="#292E40" CornerRadius="14,14,0,0" ClipToBounds="True">
                      <Grid><Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/><Border Background="#CC10121A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" Margin="12"><TextBlock Text="{Binding Category}"/></Border></Grid>
                    </Border>
                    <StackPanel Margin="16">
                      <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                      <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="DownloadOnline_Click" Background="{StaticResource Accent}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ScreensView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Button Content="{local:Translate Key=IdentifyDisplays}" Click="Identify_Click" Margin="0,0,10,12"/><Button Content="{local:Translate Key=Refresh}" Click="RefreshScreens_Click"/></StackPanel>
          <TextBlock Text="{local:Translate Key=DisplayNumbersMatchTheIdentificationLabelsShownByThisApp}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Canvas x:Name="DisplayLayout" Height="160" Margin="0,0,0,20"/>
          <TextBlock x:Name="ScreenNotice" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
          <ItemsControl x:Name="DisplayList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DisplayCardViewModel}">
                <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding CurrentScene}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="{local:Translate Key=ChooseAWallpaper}" Margin="0,0,0,6"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{local:Translate Key=ChooseTheWallpaperForThisDisplay}"/>
                      <Button Grid.Column="1" Content="{local:Translate Key=ApplyToThisDisplay}" Tag="{Binding}" Click="ApplyToScreen_Click" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <Button Grid.Column="2" Content="{local:Translate Key=Remove}" Tag="{Binding}" Click="RemoveFromScreen_Click" IsEnabled="{Binding CanRemove}" ToolTip="{Binding RemoveHint}" Margin="0"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="RotationView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RotationPanel" MaxWidth="920" HorizontalAlignment="Left"/>
      </ScrollViewer>
      <ScrollViewer x:Name="AboutView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="780">
          <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="{StaticResource BrandIcon}" Width="88" Height="88" VerticalAlignment="Top" Margin="0,0,22,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="seeWallpaper" FontSize="32" FontWeight="SemiBold"/>
              <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
              <TextBlock Text="{local:Translate Key=AnimatedScenesThatBringYourWindowsDesktopToLife}" FontSize="16" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="24" Margin="0,0,0,28">
            <StackPanel>
              <TextBlock Text="{local:Translate Key=Creator}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
              <TextBlock Text="Michael Ruffenach" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{local:Translate Key=DesignAndCreationOfSeeWallpaper}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{local:Translate Key=WhatYouCanDo}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <TextBlock Text="{local:Translate Key=ASceneForEveryDisplay}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{local:Translate Key=ChooseWhichDisplaysToAnimateApplyDifferentScenesOrUseDuplicateAndSpanModes}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="{local:Translate Key=MakeYourDesktopYourOwn}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{local:Translate Key=PreviewWallpapersAdjustTheirSettingsAndFindYourFavorites}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="{local:Translate Key=ScenesToShare}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{local:Translate Key=ImportAndExportSeewallPackagesOrDuplicateASceneToCustomizeIt}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="{local:Translate Key=AdjustablePerformance}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{local:Translate Key=ChooseYourPerformanceProfileAndConfigureFullscreenOrBatteryPauses}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,24"/>
          <WrapPanel Margin="0,0,0,28">
            <Button Content="{local:Translate Key=ExploreWallpapers}" Click="Gallery_Click" Background="{StaticResource Accent}" Margin="0,0,12,8"/>
            <Button Content="{local:Translate Key=ChooseMyDisplays}" Click="Screens_Click"/>
          </WrapPanel>
          <Border BorderBrush="#292E40" BorderThickness="0,1,0,0" Padding="0,22,0,12">
            <StackPanel>
              <TextBlock Text="{local:Translate Key=TwoWaysToGetStarted}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="{local:Translate Key=WindowsInstallerShortcutsDesktopContextMenuAndUninstallFromWindowsSettings}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="{local:Translate Key=ZIPEditionExtractTheFolderThenLaunchSeeWallpaperAGettingStartedGuideIsIncluded}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" x:Name="DisplayStatus" Text="{local:Translate Key=DetectingDisplays}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</Window>
