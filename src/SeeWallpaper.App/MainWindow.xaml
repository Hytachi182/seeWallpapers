<Window x:Class="SeeWallpaper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SeeWallpaper.App" Title="seeWallpaper" Icon="{StaticResource BrandIcon}" Width="1240" Height="790" MinWidth="980" MinHeight="640" Background="{StaticResource Canvas}" Foreground="White" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#141620" Padding="18,24">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,30"><Image Source="{StaticResource BrandIcon}" Width="28" Height="28"/><TextBlock Text="seeWallpaper" FontSize="22" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <Button Content="Home" Click="Home_Click"/><Button Content="Gallery" Click="Gallery_Click"/>
          <Button x:Name="OnlineButton" Content="Online" Click="Online_Click" ToolTip="New wallpapers published on GitHub"/>
          <Button Content="Displays" Click="Screens_Click"/><Button Content="Installed" Click="Installed_Click"/>
          <Button Content="Favorites" Click="Favorites_Click"/><Button Content="Create" Click="Create_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="AboutButton" Content="About" Click="About_Click"/>
          <Button Content="Settings" Click="Settings_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Border x:Name="StartupBanner" Visibility="Collapsed" Background="#2A2238" BorderBrush="#F5B84B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="⚠ seeWallpaper does not start with Windows" FontWeight="SemiBold" Foreground="#F5B84B"/>
              <TextBlock Text="After a restart, your wallpapers stay off until you open the app. With startup enabled, they come back on every display automatically." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Start with Windows" Click="EnableStartup_Click" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Not now" Click="DismissStartup_Click" VerticalAlignment="Center" Margin="0"/>
          </Grid>
        </Border>
        <TextBlock x:Name="PageTitle" Text="Choose your wallpaper" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageDescription" Text="Choose a scene, then select the displays where it should run." Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="PageActions" Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Manage my displays" Click="Screens_Click" Margin="0,0,10,0"/>
          <Button Content="Import .seewall" Click="Import_Click" Margin="0"/>
        </StackPanel>
      </StackPanel>
      <ScrollViewer x:Name="GalleryView" Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="TemplateList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:TemplateCardViewModel}">
              <Border Width="290" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,16,20">
                <StackPanel>
                  <Border Height="155" Background="{Binding Visual}" CornerRadius="14,14,0,0" ClipToBounds="True">
                    <Grid><Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/><Border Background="#CC10121A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" Margin="12"><TextBlock Text="{Binding Category}"/></Border></Grid>
                  </Border>
                  <StackPanel Margin="16">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Content="Apply to my displays" Tag="{Binding}" Click="Apply_Click" Background="{StaticResource Accent}"/>
                    <StackPanel Orientation="Horizontal"><Button Content="Preview" Tag="{Binding}" Click="Preview_Click" Margin="0,0,8,0"/><Button Content="Customize" Tag="{Binding}" Click="Customize_Click" Margin="0"/></StackPanel>
                    <Expander Header="More actions" Foreground="{StaticResource Muted}" Margin="0,12,0,0">
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="Favorite" Tag="{Binding}" Click="Favorite_Click" Margin="0,0,6,6"/>
                        <Button Content="Export" Tag="{Binding}" Click="Export_Click" Margin="0,0,6,6"/>
                        <Button Content="Duplicate" Tag="{Binding}" Click="Duplicate_Click" Margin="0,0,6,6"/>
                        <Button Content="Uninstall" Tag="{Binding}" Click="Uninstall_Click" Margin="0,0,6,6"/>
                      </WrapPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ScrollViewer x:Name="OnlineView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="OnlineRefreshButton" Content="Check again" Click="OnlineRefresh_Click" Margin="0,0,12,0"/>
            <TextBlock x:Name="OnlineNotice" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
          </StackPanel>
          <ItemsControl x:Name="OnlineList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:OnlineTemplateCardViewModel}">
                <Border Width="290" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,16,20">
                  <StackPanel>
                    <Border Height="155" Background="#292E40" CornerRadius="14,14,0,0" ClipToBounds="True">
                      <Grid><Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/><Border Background="#CC10121A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" Margin="12"><TextBlock Text="{Binding Category}"/></Border></Grid>
                    </Border>
                    <StackPanel Margin="16">
                      <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                      <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="DownloadOnline_Click" Background="{StaticResource Accent}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ScreensView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Button Content="Identify displays" Click="Identify_Click" Margin="0,0,10,12"/><Button Content="Refresh" Click="RefreshScreens_Click"/></StackPanel>
          <TextBlock Text="Display numbers match the identification labels shown by this app." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Canvas x:Name="DisplayLayout" Height="160" Margin="0,0,0,20"/>
          <TextBlock x:Name="ScreenNotice" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
          <ItemsControl x:Name="DisplayList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DisplayCardViewModel}">
                <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding CurrentScene}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Choose a wallpaper" Margin="0,0,0,6"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Choose the wallpaper for this display"/>
                      <Button Grid.Column="1" Content="Apply to this display" Tag="{Binding}" Click="ApplyToScreen_Click" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                      <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveFromScreen_Click" IsEnabled="{Binding CanRemove}" ToolTip="{Binding RemoveHint}" Margin="0"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="AboutView" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="780">
          <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="{StaticResource BrandIcon}" Width="88" Height="88" VerticalAlignment="Top" Margin="0,0,22,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="seeWallpaper" FontSize="32" FontWeight="SemiBold"/>
              <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
              <TextBlock Text="Animated scenes that bring your Windows desktop to life." FontSize="16" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="24" Margin="0,0,0,28">
            <StackPanel>
              <TextBlock Text="Creator" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
              <TextBlock Text="Michael Ruffenach" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="Design and creation of seeWallpaper." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="What you can do" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <TextBlock Text="A scene for every display" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Choose which displays to animate, apply different scenes, or use duplicate and span modes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="Make your desktop your own" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Preview wallpapers, adjust their settings, and find your favorites." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="Scenes to share" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Import and export .seewall packages, or duplicate a scene to customize it." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
          <TextBlock Text="Adjustable performance" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Choose your performance profile and configure fullscreen or battery pauses." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,24"/>
          <WrapPanel Margin="0,0,0,28">
            <Button Content="Explore wallpapers" Click="Gallery_Click" Background="{StaticResource Accent}" Margin="0,0,12,8"/>
            <Button Content="Choose my displays" Click="Screens_Click"/>
          </WrapPanel>
          <Border BorderBrush="#292E40" BorderThickness="0,1,0,0" Padding="0,22,0,12">
            <StackPanel>
              <TextBlock Text="Two ways to get started" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="Windows installer: shortcuts, desktop context menu, and uninstall from Windows Settings." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="ZIP edition: extract the folder, then launch seeWallpaper. A getting-started guide is included." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" x:Name="DisplayStatus" Text="Detecting displays…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</Window>
