<Window x:Class="SeeWallpaper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SeeWallpaper.App" Title="seeWallpaper" Width="1240" Height="790" MinWidth="980" MinHeight="640" Background="{StaticResource Canvas}" Foreground="White" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#141620" Padding="18,24"><DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="seeWallpaper" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="LIVE DESKTOP STUDIO" Foreground="{StaticResource Muted}" FontSize="10" Margin="1,3,0,30"/>
        <Button Content="Home" Click="Home_Click"/><Button Content="Gallery" Click="Gallery_Click"/><Button Content="Installed" Click="Installed_Click"/><Button Content="Favorites" Click="Favorites_Click"/><Button Content="Create" Click="Create_Click"/>
      </StackPanel><Button DockPanel.Dock="Bottom" Content="Settings" Click="Settings_Click"/>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="38,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock x:Name="PageTitle" Text="A desktop that moves with you" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Choose an original live scene, tune it, then make it yours." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Import .seewall" Click="Import_Click" Margin="0,0,12,0"/><Border Background="#222637" CornerRadius="14" Padding="13,8"><TextBlock x:Name="DisplayStatus" Text="Detecting displays..."/></Border></StackPanel></DockPanel>
      <ScrollViewer Grid.Row="1" Margin="0,32,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TemplateList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:TemplateCardViewModel}"><Border Width="270" Height="310" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,20,20"><Grid><Grid.RowDefinitions><RowDefinition Height="164"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{Binding Visual}" CornerRadius="14,14,0,0"><Grid><TextBlock Text="{Binding Category}" Foreground="White" FontWeight="SemiBold" Margin="17,15" VerticalAlignment="Top"/><TextBlock Text="LIVE" Foreground="#D8D2FF" HorizontalAlignment="Right" Margin="0,15,17,0" VerticalAlignment="Top"/></Grid></Border><StackPanel Grid.Row="1" Margin="17,14"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/><DockPanel><TextBlock Text="{Binding Performance}" Foreground="#D8D2FF" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Customize" Tag="{Binding}" Click="Customize_Click" Margin="0,0,5,0" Padding="6,6"/><Button Content="Preview" Tag="{Binding}" Click="Preview_Click" Margin="0,0,5,0" Padding="6,6"/><Button Content="Export" Tag="{Binding}" Click="Export_Click" Margin="0,0,5,0" Padding="6,6"/><Button Content="Apply" Tag="{Binding}" Click="Apply_Click" Margin="0" Padding="8,6" Background="{StaticResource Accent}"/></StackPanel></DockPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
  </Grid>
</Window>
